# The backend's keys: copy this file to `.env` (git-ignored, never commit it) and fill in the values.
# On GitHub Actions the same names are repository secrets (docs/ARCHITECTURE.md, section 4).

# Google AI Studio key (Gemini API: triage, extraction, discovery).
GEMINI_API_KEY=
# Instagram Graph API: a long-lived token and the Instagram user id of the app's own account.
META_ACCESS_TOKEN=
IG_USER_ID=
# Only for `refresh-token` (a Meta token that doesn't expire).
META_APP_ID=
META_APP_SECRET=
# Gemini TTS for the video toolkit (media/): a separate free-tier project, so the voice never spends the sweep's quota.
MEDIA_GEMINI_API_KEY=
# OpenRouter: free vision models, being tested as another extraction model (not read by the sweep yet).
OPENROUTER_API_KEY=

# Optional settings, not keys: each has a default and is only needed to change it.
# GEMINI_LITE_ONLY=1      Flash-Lite also extracts, as final results (when Flash isn't available)
# FFMPEG=C:\path\to\ffmpeg.exe      when ffmpeg isn't on PATH (videos' preview clips)
#
# The video toolkit reads these from the environment (set them in the shell or Windows' user variables), not from
# this file: its tools and Remotion resolve them before any .env is loaded.
# PA_BAILAR_MEDIA_HOME=D:\AI\pa-bailar-media                         the generated files
# PA_BAILAR_WHISPER_PYTHON=D:\AI\whisper\.venv\Scripts\python.exe    its Whisper Python
# PA_BAILAR_ACE_PYTHON=D:\AI\ace-step\.venv\Scripts\python.exe       its ACE-Step Python
