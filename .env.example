# The backend's local settings: copy this file to `.env` (git-ignored, never commit it) and fill in the values.
# On GitHub Actions the same names are repository secrets or variables (docs/ARCHITECTURE.md, section 4).

# ---------- Required for the sweep, discovery and the admin commands ----------
# Google AI Studio key (Gemini API: triage, extraction, discovery).
GEMINI_API_KEY=
# Instagram Graph API: a long-lived token and the Instagram user id of the app's own account.
META_ACCESS_TOKEN=
IG_USER_ID=

# ---------- refresh-token only (a Meta token that doesn't expire) ----------
META_APP_ID=
META_APP_SECRET=

# ---------- Optional ----------
# OpenRouter: free vision models as another extraction model (testing against Gemini Flash).
OPENROUTER_API_KEY=
# 1: Flash-Lite also extracts, as final results (when Flash isn't available to the key).
GEMINI_LITE_ONLY=
# ffmpeg for videos' preview clips (clips.py), when it isn't on PATH.
FFMPEG=

# ---------- The video toolkit (media/README.md) ----------
# Gemini TTS: a separate free-tier project, so the voice never spends the sweep's quota.
MEDIA_GEMINI_API_KEY=
# Where generated media lives (default D:\AI\pa-bailar-media), and the Pythons of the tools that need their own.
PA_BAILAR_MEDIA_HOME=
PA_BAILAR_WHISPER_PYTHON=
PA_BAILAR_ACE_PYTHON=
