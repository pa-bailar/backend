// Cloudflare Worker for the admin page (docs/ADMIN.md): the files in public/ are served as they are; the
// requests they don't cover (/auth/..., /api/...) go to src/index.js. Cloudflare builds it from this folder on
// every push to main. The name must match the Worker's name in Cloudflare.
// Secrets aren't here: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET and SESSION_SECRET are set in Cloudflare.
{
  "name": "pa-bailar-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_USER": "jzamora5", // the only GitHub account that can sign in
    "REPO": "pa-bailar/backend",
    "STATE_BRANCH": "sweep-state", // where the sweep saves status.json
    // The audience the sweep workflow asks GitHub's identity token for (OIDC), to download story screenshots
    "OIDC_AUDIENCE": "pa-bailar-admin"
  },
  // Story screenshots waiting to be read (/api/uploads, 7-day expiry). Created in the Cloudflare dashboard
  // (Storage & Databases → KV); an id isn't a secret.
  "kv_namespaces": [{ "binding": "UPLOADS", "id": "e276f117718d4ff184e7a55567c49212" }]
}
