---
// One page per event (/evento/<id>/): what a shared link opens. Its link preview (WhatsApp, Instagram,
// Facebook) shows the event's flyer, and search engines get the event as schema.org data.
// Same detail markup as the home page's dialog (scripts/views/eventDetail.ts).
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Stripes from "../../components/Stripes.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import events from "../../../../data/events.json";
import type { DanceEvent } from "../../scripts/types";
import { formatLongDate, formatTime, placeLabel } from "../../scripts/lib/format";
import { eventPageUrl, eventTimes, flyerUrl, mainMedia, previewImagePath } from "../../scripts/lib/links";
import { eventDetailHtml } from "../../scripts/views/eventDetail";

export function getStaticPaths() {
  return (events as DanceEvent[]).map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props {
  event: DanceEvent;
}

const { event } = Astro.props;
const allEvents = events as DanceEvent[];
const accounts = [...new Set(allEvents.map((item) => item.account))].sort();
const home = import.meta.env.BASE_URL;
const today = new Date().toLocaleDateString("en-CA", { timeZone: "America/Bogota" }); // YYYY-MM-DD
const isPast = event.date < today;

const time = formatTime(event.start_time);
const description = [`${formatLongDate(event.date)}${time ? ` · ${time}` : ""}`, placeLabel(event), `@${event.account}`]
  .filter(Boolean)
  .join(" · ");

// schema.org Event (https://schema.org/Event), as search engines read it.
const { start, end, allDay } = eventTimes(event);
const isoDateTime = (value: string) =>
  allDay
    ? `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}`
    : `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}T${value.slice(9, 11)}:${value.slice(11, 13)}:00-05:00`;
const flyer = flyerUrl(mainMedia(event));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  startDate: isoDateTime(start),
  ...(allDay ? {} : { endDate: isoDateTime(end) }),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  url: eventPageUrl(event),
  ...(flyer ? { image: [new URL(flyer, Astro.site).href] } : {}),
  location: {
    "@type": "Place",
    name: event.venue ?? event.organizer ?? `@${event.account}`,
    address: {
      "@type": "PostalAddress",
      ...(event.address ? { streetAddress: event.address } : {}),
      addressLocality: "Bogotá",
      addressCountry: "CO",
    },
  },
  organizer: { "@type": "Organization", name: event.organizer ?? `@${event.account}`, url: `https://www.instagram.com/${event.account}/` },
  ...(event.prices.length
    ? {
        offers: event.prices.map((price) => ({
          "@type": "Offer",
          name: price.label,
          price: price.amount_cop,
          priceCurrency: "COP",
          url: mainMedia(event).permalink,
        })),
      }
    : {}),
};
// Escape "<" so no text can end the inline script blocks early.
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<BaseLayout title={`${event.title} · Pa' Bailar`} description={description} image={previewImagePath(event)}>
  <script slot="head" type="application/ld+json" set:html={json(structuredData)} />

  <header class="container event-page__header">
    <div class="site-header__top">
      <Stripes />
      <ThemeToggle />
    </div>
    <a class="event-page__logo" href={home}>Pa' Bailar</a>
    <a class="event-page__back" href={home}>← Ver todos los eventos</a>
  </header>

  <main class="container">
    {isPast && <p class="callout event-page__past">Este evento ya pasó.</p>}
    <article class="event-page event-dialog__layout" id="event-detail" set:html={eventDetailHtml(event, 0, { headingLevel: 1 })} />
  </main>

  <SiteFooter accounts={accounts} />

  <script type="application/json" id="event-data" set:html={json(event)} />
  <script>
    import { initEventPage } from "../../scripts/eventPage";
    initEventPage();
  </script>
</BaseLayout>
