---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stripes from "../components/Stripes.astro";

const home = import.meta.env.BASE_URL;
---

<BaseLayout title="Página no encontrada · Pa' Bailar" description="Esta página no existe.">
  <main class="container not-found">
    <Stripes />
    <h1 class="site-header__logo">Pa' Bailar</h1>
    <p class="not-found__message">Esta página no existe… pero la pista sigue abierta.</p>
    <a class="btn btn--primary" href={home}>Ver los eventos</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .not-found .stripes {
    width: 100%;
  }

  .not-found__message {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--text-italic);
  }
</style>
