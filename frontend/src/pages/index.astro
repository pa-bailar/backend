---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalendarView from "../components/CalendarView.astro";
import EventDialog from "../components/EventDialog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ViewToolbar from "../components/ViewToolbar.astro";
import events from "../../../data/events.json";
import meta from "../../../data/meta.json";

const accounts = [...new Set(events.map((event) => event.account))].sort();
// Escape "<" so a caption can never end the inline JSON script block early.
const eventsJson = JSON.stringify(events).replace(/</g, "\\u003c");
// When the backend last refreshed the data (not when the site was built).
const updatedLabel = new Date(meta.generated_at).toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  timeZone: "America/Bogota",
});
// Link previews show the flyer of the next upcoming event.
const today = new Date().toLocaleDateString("en-CA", { timeZone: "America/Bogota" }); // YYYY-MM-DD
const previewImage = events.find((event) => event.date >= today)?.media[0]?.flyer ?? null;
---

<BaseLayout
  title="Pa' Bailar · Bogotá"
  description="Sociales y talleres de baile en Bogotá: salsa, bachata, mambo y más, en un solo lugar."
  image={previewImage}
>
  <SiteHeader updatedLabel={updatedLabel} />
  <ViewToolbar />

  <main class="container page-main">
    <section id="view-upcoming" role="tabpanel" aria-labelledby="tab-upcoming"></section>
    <CalendarView />
  </main>

  <SiteFooter accounts={accounts} />
  <EventDialog />

  <script type="application/json" id="events-data" set:html={eventsJson} />
  <script>
    import { start } from "../scripts/main";
    start();
  </script>
</BaseLayout>
