---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalendarView from "../components/CalendarView.astro";
import EventDialog from "../components/EventDialog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ViewToolbar from "../components/ViewToolbar.astro";
import events from "../../../data/events.json";

const accounts = [...new Set(events.map((event) => event.account))].sort();
// Escape "<" so a caption can never end the inline JSON script block early.
const eventsJson = JSON.stringify(events).replace(/</g, "\\u003c");
const updatedLabel = new Date().toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  timeZone: "America/Bogota",
});
---

<BaseLayout
  title="Pa' Bailar · Bogotá"
  description="Sociales y talleres de baile en Bogotá: salsa, bachata, mambo y más, en un solo lugar."
>
  <SiteHeader updatedLabel={updatedLabel} />
  <ViewToolbar />

  <main class="container page-main">
    <section id="view-upcoming" aria-live="polite"></section>
    <CalendarView />
  </main>

  <SiteFooter accounts={accounts} />
  <EventDialog />

  <script type="application/json" id="events-data" set:html={eventsJson} />
  <script>
    import { start } from "../scripts/main";
    start();
  </script>
</BaseLayout>
