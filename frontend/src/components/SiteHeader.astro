---
import Stripes from "./Stripes.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  updatedLabel: string;
}

const { updatedLabel } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__top">
      <Stripes />
      <ThemeToggle />
    </div>
    <h1 class="site-header__logo">Pa' Bailar</h1>
    <p class="site-header__tagline">sociales y talleres de baile en Bogotá</p>
    <p class="site-header__updated">Actualizado el {updatedLabel}</p>
  </div>
</header>
