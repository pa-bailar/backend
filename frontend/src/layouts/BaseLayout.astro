---
// HTML shell shared by every page: meta tags, fonts, design system styles and the theme pre-paint script.
//
// Styles are imported one by one (not chained with CSS @import) so the dev server reloads each file
// when it changes. Order matters: tokens → base → components.
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components/stripes.css";
import "../styles/components/buttons.css";
import "../styles/components/tags.css";
import "../styles/components/site-header.css";
import "../styles/components/toolbar.css";
import "../styles/components/event-card.css";
import "../styles/components/calendar.css";
import "../styles/components/event-dialog.css";
import "../styles/components/site-footer.css";

interface Props {
  title: string;
  description: string;
  /** Path of an image under the site's public folder (e.g. a flyer) for link previews. */
  image?: string | null;
}

const { title, description, image } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${image}`, Astro.site) : null;

// Record-label favicon in the brand colors (wine + marigold).
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>" +
      "<circle cx='32' cy='32' r='30' fill='#2A0F14'/><circle cx='32' cy='32' r='14' fill='#F2C12E'/>" +
      "<circle cx='32' cy='32' r='3' fill='#2A0F14'/></svg>",
  );
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <!-- Link previews (WhatsApp, Instagram, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Pa' Bailar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#ECDDC6" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Bodoni+Moda:ital,opsz,wght@1,6..96,500&family=Instrument+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Apply the theme before first paint so the page never flashes the wrong one.
         Mirrors resolveTheme() in scripts/theme.ts: saved mode, else light 6:00–17:59 / dark otherwise. -->
    <script is:inline>
      (function () {
        var mode = "auto";
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") mode = saved;
        } catch (e) {}
        var hour = new Date().getHours();
        var theme = mode === "auto" ? (hour >= 6 && hour < 18 ? "light" : "dark") : mode;
        var root = document.documentElement;
        root.dataset.theme = theme;
        root.dataset.themeMode = mode;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#2A0F14" : "#ECDDC6");
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
